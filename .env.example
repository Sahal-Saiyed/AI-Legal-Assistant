# Gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=2048
TIMEOUT=120

# MongoDB Atlas authentication database
MONGODB_URI=mongodb+srv://jurigpt_app:replace_with_database_password@jurigpt-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=jurigpt

# Generate a unique random value containing at least 32 characters
JWT_SECRET_KEY=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
