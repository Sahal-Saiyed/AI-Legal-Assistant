# syntax=docker/dockerfile:1

FROM python:3.11-slim AS runtime-deps

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    E5_MODEL_NAME=/opt/models/e5-base-v2

WORKDIR /app

# Keep large dependency families in separate OCI layers. Vercel Container
# Registry rejects an individual oversized layer even when the complete image
# is within the Function package limit.
COPY backend/requirements.vercel-base.txt /tmp/requirements.vercel-base.txt
COPY backend/requirements.vercel-ml.txt /tmp/requirements.vercel-ml.txt
COPY backend/requirements.vercel-chroma.txt /tmp/requirements.vercel-chroma.txt

RUN python -m pip install --upgrade pip
RUN python -m pip install -r /tmp/requirements.vercel-base.txt
RUN python -m pip install torch==2.8.0 \
    --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install -r /tmp/requirements.vercel-ml.txt
RUN python -m pip install -r /tmp/requirements.vercel-chroma.txt \
    && python -m pip check


FROM runtime-deps AS model-builder

# Download the model only in this temporary stage. The helper saves
# Transformers-compatible shards and balances them across small directories.
COPY backend/build/prepare_vercel_model.py /tmp/prepare_vercel_model.py
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 \
    python /tmp/prepare_vercel_model.py


FROM runtime-deps AS runtime

# Each COPY creates a separate registry layer. Empty directories are created by
# the helper as well, so the number of COPY statements remains deterministic.
COPY --from=model-builder /tmp/model-layers/01/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/02/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/03/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/04/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/05/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/06/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/07/ /opt/models/e5-base-v2/
COPY --from=model-builder /tmp/model-layers/08/ /opt/models/e5-base-v2/

COPY backend /app/backend
COPY vector_dbs/chroma /app/vector_dbs/chroma
COPY knowledge_base/templates /app/knowledge_base/templates

# Vercel supplies PORT at runtime. Use one worker so the embedding model is
# loaded only once per container instance.
CMD ["sh", "-c", "exec uvicorn backend.app.main:app --host 0.0.0.0 --port \"${PORT:-8000}\" --workers 1"]
